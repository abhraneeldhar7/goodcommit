---
import Layout from '../layouts/Layout.astro';
import Demo from '../components/Demo.astro';
import InstallTabs from '../components/InstallTabs.astro';
---

<Layout>
	<main class="page">
		<header class="hero">
			<h1>Goodcommit</h1>
			<p class="tagline">Consistent commits, zero effort.</p>
			<p class="blurb">
				Type a vague message — goodcommit reads your staged changes, generates
				conventional commit options, and commits for you.
			</p>
		</header>

		<section class="demo" aria-label="Goodcommit in action">
			<Demo />
		</section>

		<section class="install-section" aria-label="Install">
			<h2>Install</h2>
			<InstallTabs />
		</section>

		<footer>
			<p>goodcommit · MIT</p>
		</footer>
	</main>
</Layout>

<style>
	.page {
		max-width: 42em;
		margin: 0 auto;
		padding: 6em 1.5em 3em;
	}

	.hero h1 {
		margin: 0;
		font-size: 2.8em;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.hero .tagline {
		margin: 0.2em 0 0;
		font-size: 1.25em;
		color: var(--muted);
		text-wrap: balance;
	}

	.hero .blurb {
		margin: 1em 0 0;
		max-width: 34em;
		color: var(--muted);
	}

	.demo {
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
	}

	.install-section {
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
	}

	.install-section h2 {
		margin: 0 0 0.75em;
		font-size: 1.4em;
		font-weight: 600;
	}

	footer {
		margin-top: 4em;
		padding-top: 1.5em;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
	}

	footer p {
		margin: 0;
		color: var(--faint);
		font-size: 14px;
	}
</style>
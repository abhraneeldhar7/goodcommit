---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CLIDemoSection from "../components/cliDemoSection.tsx";
import GithubLogo from "../assets/github_logo.svg";
import npmLogo from "../assets/npm_logo.webp";
import InstallSection from "../components/InstallSection.tsx";
import LogoSpace from "../components/LogoSpace.tsx";
import MarkdownRender from "../components/markdown-render/markdown-render";
import groqMd from "../content/groq.md?raw";
---

<Layout>
	<main class="px-4 relative pb-7">
		<div
			class="fixed top-0 left-0 w-full z-20 px-4 backdrop-blur-[20px] bg-background/40"
		>
			<div
				class="mx-auto max-w-[760px] w-full flex items-center justify-between py-2"
			>
				<p class="text-sm font-light text-foreground/80">
					Written in C++ <span class="opacity-70 mx-1">|</span> 3mb
				</p>
				<div class="flex gap-1 items-center">
					<a
						href="https://github.com/abhraneeldhar7/xommit"
						target="_blank"
						class="w-fit transition-all hover:bg-muted p-2 rounded-xs"
					>
						<Image
							src={GithubLogo}
							alt="github_logo"
							class="object-contain h-[25px] sm:h-[18px] w-fit opacity-74"
							quality={100}
						/>
					</a>
					<a
						href="https://www.npmjs.com/package/@abhraneeldhar7/xommit"
						target="_blank"
						class="w-fit transition-all hover:bg-muted p-2 px-2.5 rounded-xs"
					>
						<Image
							src={npmLogo}
							alt="npm_logo"
							class="object-contain h-[25px] sm:h-[18px] w-fit grayscale"
							quality={100}
						/>
					</a>
				</div>
			</div>
		</div>
		<div class="mx-auto max-w-[760px] w-full pt-40 sm:pt-45">
			<div class="flex items-end opacity-25">
				<span class="text-xl leading-[0.8em]">{">"}</span>
				<div
					class="h-[3px] w-3 bg-foreground animate-[pulse_800ms_ease-in-out_infinite]"
				>
				</div>
			</div>
			<h1 class="text-3xl sm:text-4xl font-[450] mt-5">
				Conventional commits <br />zero effort
			</h1>
			<p class="mt-4 text-foreground/70">
				XOMMIT is a <span class="text-foreground font-medium"
					>CLI tool</span
				> that writes conventional commits from file diffs
			</p>

			<h2
				class="font-mono text-[0.55rem] mx-auto sm:mx-0 w-fit sm:text-base mt-15 tracking-[0.0em] leading-[1.2em] sm:leading-[1em]"
			>
				<span class="text-git">██╗<LogoSpace /><LogoSpace />██╗</span
				><span
					><LogoSpace /><LogoSpace />██████╗<LogoSpace /><LogoSpace
					/>███╗<LogoSpace /><LogoSpace /><LogoSpace />███╗<LogoSpace
					/>███╗<LogoSpace /><LogoSpace /><LogoSpace />███╗<LogoSpace
					/>██╗<LogoSpace />████████╗</span
				><br />
				<span class="text-git">╚██╗██╔╝</span><span
					><LogoSpace />██╔═══██╗<LogoSpace />████╗<LogoSpace
					/>████║<LogoSpace />████╗<LogoSpace />████║<LogoSpace
					/>██║<LogoSpace />╚══██╔══╝</span
				><br />
				<span class="text-git"><LogoSpace />╚███╔╝<LogoSpace /></span
				><span
					><LogoSpace />██║<LogoSpace /><LogoSpace /><LogoSpace
					/>██║<LogoSpace />██╔████╔██║<LogoSpace
					/>██╔████╔██║<LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /><LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /></span
				><br />
				<span class="text-git"><LogoSpace />██╔██╗<LogoSpace /></span
				><span
					><LogoSpace />██║<LogoSpace /><LogoSpace /><LogoSpace
					/>██║<LogoSpace />██║╚██╔╝██║<LogoSpace
					/>██║╚██╔╝██║<LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /><LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /></span
				><br />
				<span class="text-git">██╔╝<LogoSpace />██╗</span><span
					><LogoSpace />╚██████╔╝<LogoSpace />██║<LogoSpace
					/>╚═╝<LogoSpace />██║<LogoSpace />██║<LogoSpace
					/>╚═╝<LogoSpace />██║<LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /><LogoSpace />██║<LogoSpace /><LogoSpace
					/><LogoSpace /></span
				><br />
				<span class="text-git">╚═╝<LogoSpace /><LogoSpace />╚═╝</span
				><span
					><LogoSpace /><LogoSpace />╚═════╝<LogoSpace /><LogoSpace
					/>╚═╝<LogoSpace /><LogoSpace /><LogoSpace /><LogoSpace
					/><LogoSpace />╚═╝<LogoSpace />╚═╝<LogoSpace /><LogoSpace
					/><LogoSpace /><LogoSpace /><LogoSpace />╚═╝<LogoSpace
					/>╚═╝<LogoSpace /><LogoSpace /><LogoSpace /><LogoSpace
					/>╚═╝<LogoSpace /><LogoSpace /><LogoSpace /></span
				>
			</h2>
			<div class="my-10">
				<CLIDemoSection client:load />

				<div class="mt-20 space-y-5">
					<h2 class="text-3xl">Install</h2>
					<MarkdownRender client:load content={groqMd} />
					<InstallSection client:load />
				</div>

				<div class="mt-20 space-y-5">
					<h2 class="text-3xl">Commands</h2>
					<div class="space-y-2 text-base">
						<p>
							xommit <span class="text-foreground/60"
								>{"<"}your_message_here{">"}</span>
						</p>
						<p>
							<span class="text-foreground/60"
								>or just 
							</span> xommit <span class="text-foreground/60"
								>works just fine</span>
						</p>
						<div class="w-full grid grid-cols-2 mt-6 gap-y-2.5">
							<p class="text-[#16bd0c]">--help</p>
							<p class="text-foreground/60">show tutorial</p>
							<p class="text-[#16bd0c]">--connect</p>
							<p class="text-foreground/60">
								paste in your groq key
							</p>
							<p class="text-[#16bd0c]">--reset</p>
							<p class="text-foreground/60">remove groq apikey</p>
							<p class="text-[#16bd0c]">--update</p>
							<p class="text-foreground/60">
								download latest release from github
							</p>
							<p class="text-[#16bd0c]">--version</p>
							<p class="text-foreground/60">show version</p>
						</div>
					</div>
				</div>

				<div class="mt-20">
					<h2 class="text-3xl">How AI was used in this project</h2>
					<p class="mt-3 text-foreground/70">
						I'm inspired by the black magic <a
							href="https://x.com/RubenVeidt"
							target="_blank"
							class="text-foreground underline">@ruben</a
						> does on twitter. Wanted to move past the dsa questions,
						so used AI to set-up the skeleton and iterated over it. I'm
						using this project to learn cpp in-depth, wanted to share
						a cool tool.
					</p>
				</div>
			</div>
			<p class="text-foreground/80 mt-20 text-center">Made by <a href="https://x.com/veryNeel" target="_blank" class="text-foreground underline">abhraneel</a></p>
		</div>

		<!-- <header>
      <h1 class="m-0 text-[2.8em] leading-[1.1] tracking-tight text-balance">Xommit</h1>
      <p class="mt-1 text-[1.25em] text-muted text-balance">Consistent commits, zero effort.</p>
      <p class="mt-4 max-w-[34em] text-muted">
        Type a vague message — xommit reads your staged changes, generates
        conventional commit options, and commits for you.
      </p>
    </header>

    <section class="mt-14 pt-8 border-t border-black/8" aria-label="Xommit in action">
      <Demo />
    </section>

    <section class="mt-14 pt-8 border-t border-black/8" aria-label="Install">
      <h2 class="m-0 mb-3 text-[1.4em] font-semibold">Install</h2>
      <InstallTabs client:load />
    </section>

    <footer class="mt-16 pt-6 border-t border-black/8">
      <p class="m-0 text-faint text-sm">xommit · MIT</p>
    </footer> -->
	</main>
</Layout>

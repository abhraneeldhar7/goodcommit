<div class="install">
	<div class="tabs" role="tablist" aria-label="Installation method">
		<button type="button" role="tab" id="tab-npm" aria-selected="true" aria-controls="panel-npm" data-panel="npm">
			npm
		</button>
		<button type="button" role="tab" id="tab-curl" aria-selected="false" aria-controls="panel-curl" data-panel="curl">
			curl
		</button>
		<button type="button" role="tab" id="tab-manual" aria-selected="false" aria-controls="panel-manual" data-panel="manual">
			manual
		</button>
	</div>

	<div class="panels">
		<div class="panel" id="panel-npm" role="tabpanel" aria-labelledby="tab-npm" data-panel="npm">
			<div class="code">
				<code>npm install -g xommit</code>
				<button type="button" class="copy" data-copy="npm install -g xommit">copy</button>
			</div>
			<p>Requires Node.js. Adds the <code>xommit</code> command to your PATH.</p>
		</div>

		<div class="panel" id="panel-curl" role="tabpanel" aria-labelledby="tab-curl" data-panel="curl" hidden>
			<div class="code">
				<code>curl -fsSL https://raw.githubusercontent.com/abhraneeldhar7/xommit/main/cli-tool/scripts/install.sh | bash</code>
				<button type="button" class="copy" data-copy="curl -fsSL https://raw.githubusercontent.com/abhraneeldhar7/xommit/main/cli-tool/scripts/install.sh | bash">copy</button>
			</div>
			<p>Linux/macOS. Downloads a standalone binary — no Node.js required.</p>
		</div>

		<div class="panel" id="panel-manual" role="tabpanel" aria-labelledby="tab-manual" data-panel="manual" hidden>
			<div class="code">
				<code>cd cli-tool<br />node scripts/build.js</code>
				<button type="button" class="copy" data-copy="cd cli-tool
node scripts/build.js">copy</button>
			</div>
			<p>Then copy <code>bin/xommit</code> into a directory on your PATH.</p>
		</div>
	</div>

	<p class="next">Then set your API key: <code>xommit --key add</code></p>
</div>

<style is:global>
	.install {
		font-size: 16px;
	}

	.install .tabs {
		display: flex;
		gap: 1.25em;
	}

	.install .tabs button {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font: inherit;
		color: var(--faint);
	}

	.install .tabs button:hover {
		color: var(--text);
	}

	.install .tabs button[aria-selected='true'] {
		color: var(--text);
		font-weight: 600;
	}

	.install .panel {
		margin-top: 0.9em;
	}

	.install .code {
		font-family: var(--mono);
		font-size: 15px;
		white-space: pre;
	}

	.install .code code {
		display: inline;
		font-family: inherit;
	}

	.install .code .copy {
		margin-left: 1em;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font: inherit;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
			sans-serif;
		font-size: 13px;
		color: var(--faint);
	}

	.install .code .copy:hover {
		color: var(--accent);
	}

	.install p {
		margin: 0.4em 0 0;
		color: var(--muted);
		font-size: 15px;
	}

	.install p code {
		font-family: var(--mono);
		font-size: 0.92em;
		background: none;
		padding: 0;
		color: var(--text);
	}

	.install .next {
		margin-top: 1.5em;
		color: var(--text);
	}
</style>

<script>
	const install = document.querySelector(".install");
	const tabs = install.querySelectorAll('[role="tab"]');
	const panels = install.querySelectorAll('[role="tabpanel"]');

	function activate(name) {
		tabs.forEach((t) => {
			t.setAttribute("aria-selected", t.dataset.panel === name ? "true" : "false");
		});
		panels.forEach((p) => {
			p.hidden = p.dataset.panel !== name;
		});
	}

	tabs.forEach((tab, i) => {
		tab.addEventListener("click", () => {
			activate(tab.dataset.panel);
		});
		tab.addEventListener("keydown", (e) => {
			if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
			e.preventDefault();
			const next = (i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length;
			tabs[next].focus();
			activate(tabs[next].dataset.panel);
		});
	});

	install.querySelectorAll(".copy").forEach((btn) => {
		btn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy);
				const prev = btn.textContent;
				btn.textContent = "copied";
				setTimeout(() => {
					btn.textContent = prev;
				}, 1200);
			} catch {}
		});
	});
</script>
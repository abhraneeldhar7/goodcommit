<div class="demo" aria-live="off">
	<div class="lines"></div>
</div>

<style is:global>
	.demo .lines {
		font-family: var(--mono);
		font-size: 15px;
		line-height: 1.75;
		white-space: pre;
		color: var(--text);
		min-height: 16.5em;
		overflow-wrap: anywhere;
	}

	.demo .prompt {
		color: var(--accent);
	}

	.demo .spin {
		color: var(--muted);
	}

	.demo .hint {
		color: var(--faint);
	}

	.demo .sel {
		color: var(--accent);
		font-weight: 600;
	}

	.demo .opt {
		color: var(--text);
	}

	.demo .ok {
		color: var(--accent);
		font-weight: 600;
	}

	.demo .commit-hash {
		color: var(--muted);
	}

	.demo .caret {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--text);
		animation: gc-blink 1.06s steps(1) infinite;
	}

	@keyframes gc-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}
</style>

<script>
	const lines = document.querySelector(".demo .lines");
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const SCENARIOS = [
		{
			cmd: 'fixed the login bug',
			options: [
				"fix(login): resolve login failure on invalid password",
				"fix(auth): improve failed-login error handling",
				"fix(login): redirect user after successful sign-in",
			],
			pick: 1,
			hash: "8f3a2c1",
			stats: " 3 files changed, 42 insertions(+), 6 deletions(-)",
		},
		{
			cmd: 'added pagination to the user list',
			options: [
				"feat(users): add pagination to user list",
				"feat(users): implement pagination for user list",
				"feat(ui): add pagination controls to user table",
			],
			pick: 2,
			hash: "b74d9e0",
			stats: " 5 files changed, 148 insertions(+), 12 deletions(-)",
		},
		{
			cmd: 'improved api error handling',
			options: [
				"refactor(api): centralize error handling",
				"fix(api): return consistent error responses",
				"refactor(api): improve error handling on requests",
			],
			pick: 0,
			hash: "2ac55f3",
			stats: " 6 files changed, 90 insertions(+), 31 deletions(-)",
		},
		{
			cmd: 'removed old analytics script',
			options: [
				"chore(analytics): remove legacy tracking script",
				"refactor(analytics): drop unused analytics code",
				"chore: remove deprecated analytics integration",
			],
			pick: 2,
			hash: "e1c8d42",
			stats: " 2 files changed, 74 deletions(-)",
		},
		{
			cmd: 'upgraded dependencies and fixed build',
			options: [
				"build(deps): upgrade dependencies and fix build",
				"chore(deps): bump dependency versions",
				"fix(build): resolve failures after dependency upgrade",
			],
			pick: 1,
			hash: "09fbe7a",
			stats: " 9 files changed, 512 insertions(+), 118 deletions(-)",
		},
	];

	const wait = (ms) => new Promise((r) => setTimeout(r, ms));

	function newLine() {
		const el = document.createElement("div");
		lines.appendChild(el);
		return el;
	}

	function setCaret(el) {
		const old = lines.querySelector(".caret");
		if (old) old.remove();
		const c = document.createElement("span");
		c.className = "caret";
		el.appendChild(c);
	}

	function addText(el, text, className) {
		const span = document.createElement("span");
		if (className) span.className = className;
		span.textContent = text;
		el.appendChild(span);
	}

	function clear() {
		lines.textContent = "";
	}

	async function typeCommand(s) {
		const el = newLine();
		addText(el, "$ ", "prompt");
		const cmd = 'goodcommit "' + s.cmd + '"';
		for (let i = 0; i < cmd.length; i++) {
			addText(el, cmd[i]);
			setCaret(el);
			await wait(45);
		}
		setCaret(el);
		await wait(400);
	}

	async function spinner() {
		const el = newLine();
		const frames = ["|", "/", "-", "\\"];
		let i = 0;
		const end = Date.now() + 1500;
		while (Date.now() < end) {
			el.textContent = "";
			addText(el, "  " + frames[i % 4] + " Generating...", "spin");
			setCaret(el);
			i++;
			await wait(80);
		}
		el.remove();
	}

	async function selectOptions(s) {
		const optEls = s.options.map(() => {
			const el = newLine();
			return el;
		});
		const hint = newLine();
		addText(hint, "  (↑↓ to navigate, Enter to confirm)", "hint");

		let selected = 0;
		const draw = () => {
			s.options.forEach((opt, i) => {
				const el = optEls[i];
				el.textContent = "";
				if (i === selected) {
					addText(el, "  ❯ ", "sel");
					addText(el, opt, "sel");
				} else {
					addText(el, "    ", null);
					addText(el, opt, "opt");
				}
			});
			setCaret(optEls[selected]);
		};
		draw();
		await wait(800);

		while (selected < s.pick) {
			selected++;
			draw();
			await wait(750);
		}

		hint.remove();
		optEls.forEach((el) => el.remove());

		const ok = newLine();
		addText(ok, "  ✔ " + s.options[selected], "ok");
		setCaret(ok);
		await wait(650);
	}

	async function gitOutput(s) {
		const msg = s.options[s.pick];
		const l1 = newLine();
		addText(l1, "[main ", "commit-hash");
		addText(l1, s.hash, "commit-hash");
		addText(l1, "] " + msg);
		setCaret(l1);
		await wait(500);

		const l2 = newLine();
		addText(l2, s.stats);
		setCaret(l2);
	}

	async function playScenario(s) {
		await typeCommand(s);
		await spinner();
		await selectOptions(s);
		await gitOutput(s);
		await wait(2200);
	}

	async function play() {
		for (const s of SCENARIOS) {
			clear();
			await playScenario(s);
		}
		clear();
		setTimeout(play, 600);
	}

	if (reduced) {
		SCENARIOS.forEach((s, si) => {
			if (si > 0) newLine();
			const cmd = newLine();
			addText(cmd, "$ ", "prompt");
			addText(cmd, 'goodcommit "' + s.cmd + '"');
			const spin = newLine();
			addText(spin, "  | Generating...", "spin");
			s.options.forEach((opt, i) => {
				const el = newLine();
				if (i === s.pick) {
					addText(el, "  ❯ " + opt, "sel");
				} else {
					addText(el, "    " + opt, "opt");
				}
			});
			const hint = newLine();
			addText(hint, "  (↑↓ to navigate, Enter to confirm)", "hint");
			const ok = newLine();
			addText(ok, "  ✔ " + s.options[s.pick], "ok");
			const g1 = newLine();
			addText(g1, "[main " + s.hash + "] " + s.options[s.pick]);
			const g2 = newLine();
			addText(g2, s.stats);
		});
	} else {
		play();
	}
</script>